# Copia este archivo como .env y rellena tus valores.
# El archivo .env esta en .gitignore: nunca se sube a Git.

# --- MySQL local (base olist) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=olist
# Recomendado: el usuario de solo lectura que crea scripts/usuario_mysql.sql
DB_USER=practicador
DB_PASSWORD=pon_aqui_tu_contrasena

# --- Opcional ---
# Carpeta con el material del curso (por defecto, la carpeta que contiene a practicador)
# CURSO_DIR=E:\Data_Analytic
# Segundos maximos para ejecutar tu codigo Python
# TIMEOUT_PYTHON=15
